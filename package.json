{
  "name": "farcipal-launcher",
  "version": "0.1.0",
  "description": "Лаунчер Minecraft в стиле FARCIPAL",
  "main": "main.js",
  "author": "apomous",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.farcipal.launcher",
    "productName": "Farcipal Launcher",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}